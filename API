## HOW TO ADD A REGISTER

# create a blank register
register add --name register_name \
             [--file /path/to/register_file] \
             [--exec | --no-exec] \
             [--utf8 | --binary]

# create from given file
register add --name register_name \
             [--file /path/to/register_file] \
             --source given_filename \
             [--exec | --no-exec] \
             [--utf8 | --binary]

# from clipboard
register add --name register_name \
             [--file /path/to/register_file] \
             --source CLIPBOARD \
             [--exec | --no-exec] \
             [--utf8 | --binary]

# from primary
register add --name register_name \
             [--file /path/to/register_file] \
             --source PRIMARY \
             [--exec | --no-exec] \
             [--utf8 | --binary]

NOTE:	if --file is omitted, then register_file will be named register_name (and in practice all register files will be stored in the ~/.register/ directory)
		error if name already exists
		error if file points to a file that is already in some other register




## HOW TO REMOVE A REGISTER

register remove --name register_name

NOTE:	this deletes the register entry and the register file
		error if name not found


